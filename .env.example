DECODO_AUTH_TOKEN=tu_token

TURSO_DATABASE_URL=tu_database_url
TURSO_AUTH_TOKEN=tu_auth_token

AMAZON_ASINS_ES=tu_asin_es1,tu_asin_es2
AMAZON_ASINS_US=tu_asin_us1,tu_asin_us2

ML_ITEMS=MLA1389091840,MLA3008668676
# --- Tracker PS5 (pnpm ps5) - todo opcional ---
# Tiendas de Amazon a consultar: com | mx | es | br (default com)
AMAZON_STORES=com
# ZIP de EEUU para ver precios en USD en amazon.com (default 10001)
AMAZON_ZIP=10001
# Ubicacion de Facebook Marketplace (slug de la URL, default buenosaires)
FB_MARKETPLACE_LOCATION=buenosaires
# Ruta a Chromium/Chrome si no esta en una ubicacion estandar
CHROMIUM_PATH=
# BD de historial (default file:data/ps5.db); Turso: libsql://... + PS5_DB_TOKEN
PS5_DB_URL=
PS5_DB_TOKEN=
# Mercado Libre exige login: sesion propia exportada con Playwright (no se commitea)
ML_STORAGE_STATE=
